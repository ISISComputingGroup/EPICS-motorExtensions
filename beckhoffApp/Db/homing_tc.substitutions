    {"\$(P)", "ASTAXES_\$(AXIS_NUM):STHOMING-EHOMESEQ", "\$(PORT)", "\$(ADSPORT)", "GVL.astAxes[\$(AXIS_NUM)].stHomingConfig.eHomeSeq", longout, "asynInt64", "UDINT"}
}

