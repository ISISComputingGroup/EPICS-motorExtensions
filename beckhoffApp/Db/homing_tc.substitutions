file "$(TOP)/beckhoffApp/beckhoff_write_pv.template" {
    pattern {P, NAME, PORT, ADSPORT, V, RECTYPE, EPICSDTYP, ADS_TYPE}

    {"\$(P)", "ASTAXES_\$(AXIS_NUM):STHOMING-BGOTOFWDFIRST", "\$(PORT)", "\$(ADSPORT)", "GVL.astAxes[\$(AXIS_NUM)].stHomingConfig.bGoToFwdFirst", longout, "asynInt32", "BOOL"}
